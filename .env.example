# Copy this file to ".env" and fill it in. Never share your .env file.
GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
PORT=3000

# OPTIONAL: lets GrideX email the 6-digit sign-up code instead of showing it in the black window.
# Use a Gmail address + an "App password" (Google Account > Security > 2-Step Verification > App passwords).
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-letter-app-password
